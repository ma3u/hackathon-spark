# Vorlage — kopiere nach .env und trage echte Werte ein (.env ist gitignored).
#   cp .env.example .env

# Azure AI Foundry (OpenAI-kompatibler v1-Endpoint)
AZURE_AI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_API_KEY=<dein-api-key>
MISTRAL_DEPLOYMENT=Mistral-Large-3
KIMI_DEPLOYMENT=Kimi-K2.6
EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIM=3072

# Lokales Neo4j (Standard 7687; eigene/isolierte Instanz z. B. 7688)
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=healthdataspace
DIP_API_KEY=
