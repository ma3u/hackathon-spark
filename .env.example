# Vorlage — kopiere nach .env und trage echte Werte ein (.env ist gitignored).
#   cp .env.example .env

# Azure AI Foundry (OpenAI-kompatibler v1-Endpoint)
AZURE_AI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_API_KEY=<dein-api-key>
MISTRAL_DEPLOYMENT=Mistral-Large-3
KIMI_DEPLOYMENT=Kimi-K2.6
EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIM=3072

# LLM-Anbieter = Konfiguration (Provider-Unabhängigkeit, ADR-0015). Diese GENERISCHEN Werte
# überschreiben die AZURE_*-Werte oben; ohne sie gilt weiter Azure. Nur portabler Teilumfang
# (chat.completions + embeddings). Anbieter wechseln = nur diese Zeilen ändern + ggf. neu embedden.
# LLM_PROVIDER=azure        # azure|ollama|vllm|openrouter|litellm|localai|custom
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_CHAT_MODEL=
# Presets (auskommentiert — eine Gruppe einkommentieren):
#   Ollama (on-prem):  LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama  LLM_CHAT_MODEL=mistral-large
#   vLLM (on-prem):    LLM_BASE_URL=http://localhost:8000/v1    LLM_API_KEY=-       LLM_CHAT_MODEL=<served-model>
#   OpenRouter:        LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=<key> LLM_CHAT_MODEL=mistralai/mistral-large
#   LiteLLM-Gateway:   LLM_BASE_URL=http://localhost:4000/v1    LLM_API_KEY=<key>  LLM_CHAT_MODEL=<alias>
# Embeddings sind modell-/dim-gebunden: Modellwechsel ⇒ scripts/vector_search.py --reembed
#   (bei anderer Dimension Vektor-Index neu anlegen). Selbst-hostbar z. B. bge-m3 / multilingual-e5.

# Lokales Neo4j (Standard 7687; eigene/isolierte Instanz z. B. 7688)
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=healthdataspace
DIP_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# YouTube Data API v3 (clip discovery, ADR-0013) — GCP API key restricted to youtube.googleapis.com
YOUTUBE_API_KEY=
