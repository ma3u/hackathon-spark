# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Demo run artifacts (regenerated by run_demo.py; web/data/ is intentionally tracked)
output/

# Neo4j local data (docker-compose.neo4j.yml)
neo4j/data/
neo4j/logs/

# Inkrementell heruntergeladene Rohquellen (re-downloadbar via scripts/sync_sessions.py;
# zu groß für das Repo). Der Status (sessions_state.json) + die web/data-Ausgaben sind getrackt.
data/real/yt/
data/real/amt/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code: shared config (.claude/settings.json, rules, commands, skills, agents) is
# tracked; personal/local overrides are not.
.claude/settings.local.json

# Secrets / local config — NEVER commit (Azure endpoint+key, Neo4j creds, …)
.env
.env.*
!.env.example
