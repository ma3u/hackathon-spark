      "end_sec": 0.0,
      "timecode": "Prot.",
      "sprecher": "Jonas Reuter",
      "text": "Die Bundesregierung wird dem Ausschuss bis zum 30. Juni 2026 einen regionalisierten Ausbauplan schriftlich vorlegen.",
      "audio_file": "plenarprotokoll-21-081-sample.xml",
      "schicht": "provenienz"
